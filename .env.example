# Site mode: "sales" (default) or "qa"
NEXT_PUBLIC_SITE_MODE=sales

# Email (Nodemailer / Gmail SMTP)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password
CONTACT_EMAIL=contact@yourdomain.com

# OpenAI (for assistant)
OPENAI_API_KEY=sk-your-openai-api-key

# Calendly event types (NEXT_PUBLIC_ prefix = client-accessible)
NEXT_PUBLIC_CALENDLY_QA_30=https://calendly.com/your-handle/30min
NEXT_PUBLIC_CALENDLY_QA_45=https://calendly.com/your-handle/45min
NEXT_PUBLIC_CALENDLY_QA_60=https://calendly.com/your-handle/1hour
